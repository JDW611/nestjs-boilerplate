{
    "name": "nestjs-boilerplate",
    "version": "0.0.1",
    "description": "nestjs boilerplate + typeorm",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "serve": "cross-env NODE_ENV=local nodemon --exec ts-node -r tsconfig-paths/register --files ./src/app.ts",
        "test": "jest",
        "test:dev": "cross-env NODE_ENV=test TS_NODE_FILES=true mocha --exit -timeout 3000 -r tsconfig-paths/register -r ts-node/register ./test/**/*.test.ts",
        "build": "nest build",
        "mg:create": "npx mikro-orm migration:create",
        "mg:up": "npx mikro-orm migration:up",
        "mg:down": "npx mikro-orm migration:down",
        "mg:pending": "npx mikro-orm migration:pending"
    },
    "dependencies": {
        "@js-joda/core": "^5.6.3",
        "@mikro-orm/core": "^6.6.2",
        "@mikro-orm/migrations": "^6.6.2",
        "@mikro-orm/nestjs": "^6.1.1",
        "@mikro-orm/postgresql": "^6.6.2",
        "@mikro-orm/reflection": "^6.6.2",
        "@nestjs/common": "^11",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11",
        "@nestjs/platform-express": "^11",
        "@nestjs/swagger": "^11",
        "@types/uuid": "^10.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "nest-winston": "^1.9.7",
        "nestjs-cls": "^6.1.0",
        "pg": "^8.13.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sql-formatter": "^15.6.11",
        "sqlite3": "^5.1.7",
        "uuid": "^10.0.0",
        "winston": "^3.15.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@mikro-orm/cli": "^6.6.2",
        "@nestjs/cli": "^11",
        "@nestjs/schematics": "^11",
        "@nestjs/testing": "^11",
        "@types/express": "^4.17.17",
        "@types/jest": "^29.5.2",
        "@types/node": "^22.7.5",
        "@types/supertest": "^2.0.12",
        "@types/winston": "^2.4.4",
        "@typescript-eslint/eslint-plugin": "^5.59.11",
        "@typescript-eslint/parser": "^5.59.11",
        "cross-env": "^7.0.3",
        "eslint": "^8.42.0",
        "eslint-config-prettier": "^8.8.0",
        "eslint-plugin-prettier": "^4.2.1",
        "jest": "^29.5.0",
        "prettier": "^2.8.8",
        "source-map-support": "^0.5.21",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.0",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.1.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@core/(.*)$": "<rootDir>/core/$1",
            "^@shared/(.*)$": "<rootDir>/shared/$1",
            "^@config/(.*)$": "<rootDir>/config/$1",
            "^@common/(.*)$": "<rootDir>/common/$1",
            "^@modules/(.*)$": "<rootDir>/modules/$1"
        }
    }
}
